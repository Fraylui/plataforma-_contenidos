# Secretos y configuración local — nunca commitear
.env
.env.local
.env.*.local

# Sistema operativo / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs sueltos en la raíz
*.log

# Almacenamiento local de medios (MEDIA_STORAGE_PATH) — binarios subidos, no código
data/
backend/data/

# Backups locales (scripts/backup.sh) — dumps de la base de datos, nunca commitear
/backups/

# Certificados HTTPS reales (Let's Encrypt, ver infra/nginx/init-letsencrypt.sh)
# — claves privadas, nunca commitear. La plantilla de nginx sí se versiona.
/infra/nginx/certbot/

# Capturas de pantalla de depuración local (sesión de navegador con pestañas/marcadores
# personales visibles) — nunca material del proyecto, nunca commitear.
/captura de pantalla/

# Manuales de trabajo del equipo (docs/manuales/*.docx) — uso interno del
# usuario, no material para el repositorio público.
/docs/
