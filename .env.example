# Copia este archivo a .env y completa los valores. Nunca commitear .env real.
# Usado por infra/docker-compose.yml y por backend/src/main/resources/application.yml

# --- PostgreSQL ---
DB_NAME=plataforma_contenidos
DB_USER=plataforma_contenidos
DB_PASSWORD=changeme-strong-password
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme-strong-password

# --- Backend ---
SERVER_PORT=8080

# --- Identity/Auth ---
# Secreto de firma JWT (HS256). Generar uno propio, ej: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-real-256-bit-secret-per-environment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Primer SUPER_ADMIN (solo se usa si todavía no existe ninguno en la BD).
# Déjalo vacío tras el primer arranque; no lo dejes con este valor en producción.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
