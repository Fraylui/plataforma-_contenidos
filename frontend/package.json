{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:visual": "playwright test visual-regression.spec.ts",
    "test:perf": "lhci autorun",
    "test:api": "docker run --rm -i --add-host=host.docker.internal:host-gateway -e BASE_URL=http://host.docker.internal:8080 grafana/k6 run - < tests/load/k6-smoke.js",
    "test:load": "docker run --rm -i --add-host=host.docker.internal:host-gateway -e PERFIL=normal -e WEB_URL=http://host.docker.internal:3000 -e API_URL=http://host.docker.internal:8080 grafana/k6 run - < tests/load/k6-simulacion.js",
    "test:peak": "docker run --rm -i --add-host=host.docker.internal:host-gateway -e PERFIL=pico -e WEB_URL=http://host.docker.internal:3000 -e API_URL=http://host.docker.internal:8080 grafana/k6 run - < tests/load/k6-simulacion.js",
    "test:stress": "docker run --rm -i --add-host=host.docker.internal:host-gateway -e PERFIL=quiebre -e PAGINAS_EN_CACHE=1 -e WEB_URL=http://host.docker.internal:3000 -e API_URL=http://host.docker.internal:8080 grafana/k6 run - < tests/load/k6-simulacion.js",
    "lint:unused": "knip"
  },
  "dependencies": {
    "@hookform/resolvers": "~5.5",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.5.1",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "knip": "^5.88.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
