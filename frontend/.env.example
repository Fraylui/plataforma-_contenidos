# Copiar a .env.local (nunca commitear). Solo se usa en Server Components,
# nunca llega al navegador (ver src/lib/api/client.ts).
BACKEND_API_URL=http://localhost:8080

# URL pública del sitio, usada para metadataBase, sitemap.xml, robots.txt y
# canonical/JSON-LD por defecto (ver src/lib/site-url.ts). En producción debe
# ser el dominio real (ej. https://ejemplo.pe).
SITE_URL=http://localhost:3000

# Origen público del backend para servir archivos que el NAVEGADOR carga
# directo (ej. <img src>) — hoy solo /api/v1/images/{id}/file (CONTEXTO.md
# sección 10; ese endpoint es público a propósito, un <img> no puede mandar
# Authorization). Único var con prefijo NEXT_PUBLIC_: es la única que debe
# llegar al bundle del navegador. En producción, normalmente distinto de
# BACKEND_API_URL (ese puede ser un host interno no alcanzable desde fuera).
NEXT_PUBLIC_BACKEND_ASSET_URL=http://localhost:8080
