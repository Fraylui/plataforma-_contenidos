# Revisa sitio, API, disco, memoria y contenedores (scripts/vigilar.sh).
# Lo lanza plataforma-vigilar.timer cada 5 minutos.
[Unit]
Description=Vigilancia de plataforma-contenidos
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/plataforma-contenidos
ExecStart=/opt/plataforma-contenidos/scripts/vigilar.sh
# El script ya avisa solo cuando el estado cambia; que su salida distinta de
# cero no marque la unidad como fallida ni dispare otro aviso.
SuccessExitStatus=1
