# Borra las imágenes de Docker con más de una semana sin uso (cada
# despliegue deja la anterior), para que el disco del VPS no se llene. No
# toca contenedores ni volúmenes (base de datos, Redis, fotos, caché de nginx).
[Unit]
Description=Limpieza semanal de Docker
After=docker.service
Requires=docker.service
OnFailure=plataforma-aviso@%n.service

[Service]
Type=oneshot
User=deploy
ExecStart=/usr/bin/docker image prune -af --filter until=168h
