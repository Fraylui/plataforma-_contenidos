# Configuración a nivel `http` (la imagen nginx:alpine incluye conf.d/*.conf
# dentro del bloque http, y el prefijo 00- hace que cargue antes que
# default.conf, que usa lo que se define acá). Objetivo: que el VPS solo
# atienda lo que Cloudflare no tiene en caché (CONTEXTO.md sección 25).

# --- IP real del visitante detrás de Cloudflare ---
# Sin esto $remote_addr es la IP del nodo de Cloudflare, y el límite por IP
# de abajo bloquearía a miles de visitantes que comparten ese nodo. Solo se
# confía en CF-Connecting-IP cuando el pedido viene de un rango de
# Cloudflare: si alguien le pega directo a la IP del VPS, no puede falsear
# su IP mandando ese header. Rangos oficiales: https://www.cloudflare.com/ips/
# (cambian muy rara vez — revisar si se agregan nuevos).
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# --- Límite de pedidos por IP ---
# Páginas: holgado (una persona navegando rápido no llega ni cerca); el
# grueso del tráfico normal ni siquiera llega acá, lo responde Cloudflare.
# API: más estricto — búsqueda, "me gusta", feed y la API JSON son lo
# que un scraper apuntaría para copiarse todo el contenido de una noche.
limit_req_zone $binary_remote_addr zone=pages:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;

# --- Conexiones abusivas (bots, ataques de conexión lenta "slowloris") ---
# Tiempos cortos: un cliente que manda las cabeceras o el cuerpo de a
# poco ya no puede retener una conexión 60 s (el valor por defecto). Tope
# de conexiones simultáneas por IP real (ver set_real_ip_from): un
# navegador normal abre pocas; un bot que abre cientos recibe 429.
# server_tokens off: nginx no anuncia su versión en las cabeceras.
# (keepalive_timeout ya lo define el nginx.conf de la imagen: repetirlo
# aquí rompe el arranque con "directive is duplicate".)
server_tokens off;
client_header_timeout 10s;
client_body_timeout 10s;
send_timeout 15s;
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_conn perip 30;
limit_conn_status 429;

# --- Caché local de nginx ---
# Segunda capa detrás de Cloudflare (que no guarda copia en todos sus nodos
# a la vez): absorbe los pedidos que Cloudflare deja pasar. Solo guarda lo
# que Next.js/Spring marcan como público (Cache-Control con max-age o
# s-maxage); todo lo "private"/"no-store" (admin, búsqueda, feed por
# visitante) pasa siempre de largo. 1 GB tope en disco, borra lo no pedido
# en 7 días.
proxy_cache_path /var/cache/nginx/app levels=1:2 keys_zone=app:20m max_size=1g inactive=7d use_temp_path=off;
