# Plantilla de Nginx (CONTEXTO.md sección 25: Internet → Cloudflare → Contabo
# → Nginx → Next.js/Spring Boot). La imagen oficial nginx:alpine corre
# envsubst sobre todo archivo en /etc/nginx/templates/*.template al arrancar
# y escribe el resultado en /etc/nginx/conf.d/ — por eso ${DOMAIN} de acá
# abajo, no hace falta tocar nada más en el contenedor.
#
# Solo se reemplaza ${DOMAIN} (variable propia, sin colisión con las
# variables internas de nginx como $host/$remote_addr, que no tienen un env
# var homónimo en el contenedor y quedan intactas).

# HTTP: sirve el desafío ACME de Let's Encrypt (webroot) y redirige el resto
# a HTTPS. Nunca sirve la app por HTTP — ni siquiera antes de tener el
# certificado (ver infra/nginx/init-letsencrypt.sh, que arranca con un
# certificado autofirmado temporal para poder levantar el bloque HTTPS de
# abajo desde el primer momento).
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# www.${DOMAIN} → ${DOMAIN} (un solo dominio canónico, mejor para SEO: nunca
# el mismo contenido servido en dos hosts distintos).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS: una vez que el sitio corre estable en HTTPS. `preload` queda
    # afuera a propósito — inscribirse en la lista de preload de los
    # navegadores es casi irreversible (semanas para salir), mejor decisión
    # explícita del usuario más adelante, no algo que se activa solo acá.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    # Sin X-Frame-Options acá: Next.js y Spring ya mandan "DENY" (más la CSP
    # frame-ancestors 'none'). Agregarlo también en nginx con otro valor
    # duplicaba la cabecera con valores en conflicto ("DENY" y
    # "SAMEORIGIN"), y ante eso los navegadores la ignoran por completo.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Igual al MEDIA_MAX_FILE_SIZE de application.yml (10MB) — si se cambia
    # uno, cambiar el otro: acá manda antes de que el pedido llegue al backend.
    client_max_body_size 10m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Imágenes del backend: Spring ya las marca públicas por 30 días
    # (ImagePublicController) — nginx guarda copia para que Java no lea el
    # mismo archivo de disco en cada pedido que Cloudflare deja pasar.
    location /api/v1/images/ {
        limit_req zone=api burst=100 nodelay;
        proxy_cache app;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API pública + admin del backend (todo vive bajo /api/v1/... — ver
    # cualquier *Controller.java). Mismo dominio que el frontend: sin esto
    # habría que configurar CORS (README.md lo señala como pendiente
    # justamente porque hoy no hace falta).
    #
    # SOLO /api/v1/: antes era `location /api/`, que también se tragaba los
    # Route Handlers de Next.js (/api/feed, /api/content/.../like,
    # /api/search-suggest, /api/youtube-oembed, /api/ads/...) y los mandaba
    # al backend, donde no existen — en producción el scroll infinito, los
    # "me gusta" y las sugerencias de búsqueda habrían dado 404.
    location /api/v1/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Route Handlers de Next.js (feed, me gusta, sugerencias, anuncios
    # directos): dinámicos por visitante, nunca se cachean — solo límite.
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Panel admin: siempre fresco y por usuario — sin caché de nginx.
    location /admin {
        limit_req zone=pages burst=60 nodelay;
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next.js (todo lo demás): estáticos, páginas públicas, Server Actions.
    # Las páginas públicas son ISR (Next manda `s-maxage`), así que nginx
    # guarda copia mientras Next diga que sigue vigente; lo dinámico
    # (`private, no-store`) y cualquier respuesta con Set-Cookie no se
    # guarda nunca. La clave incluye los headers RSC: la misma URL devuelve
    # HTML o el payload de navegación del cliente según esos headers, y
    # mezclarlos rompería la navegación.
    location / {
        limit_req zone=pages burst=60 nodelay;
        proxy_cache app;
        proxy_cache_key "$scheme$host$request_uri|$http_rsc|$http_next_router_prefetch|$http_next_router_segment_prefetch";
        proxy_cache_bypass $cookie_admin_access_token $cookie_admin_refresh_token;
        proxy_no_cache $cookie_admin_access_token $cookie_admin_refresh_token;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js usa WebSocket para el HMR en dev — en producción (build
        # standalone) no lo necesita, pero dejarlo no rompe nada y evita
        # sorpresas si algún día se sirve algo con upgrade de conexión.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
